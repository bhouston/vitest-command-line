{
  "name": "vitest-command-line",
  "version": "0.9.0",
  "description": "Helpers and matchers for testing command-line tools with Vitest",
  "keywords": [
    "cli",
    "command-line",
    "subprocess",
    "testing",
    "vitest"
  ],
  "homepage": "https://github.com/bhouston/vitest-command-line#readme",
  "bugs": {
    "url": "https://github.com/bhouston/vitest-command-line/issues"
  },
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/vitest-command-line.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./yargs": {
      "types": "./dist/yargs.d.ts",
      "import": "./dist/yargs.js"
    }
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc",
    "tsc": "tsc",
    "dev": "tsc -w --preserveWatchOutput --noEmitOnError",
    "test": "vitest run",
    "test:types": "pnpm build && tsc -p tsconfig.type-test.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "make-release": "node scripts/make-release.mjs ."
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^7",
    "vitest": "^4.1.10",
    "yargs": "^18.0.0"
  },
  "peerDependencies": {
    "vitest": ">=1 <5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.0.8"
}
