{
  "name": "vitest-command-line",
  "version": "0.9.0",
  "description": "Helpers and matchers for testing command-line tools with Vitest",
  "keywords": [
    "cli",
    "command-line",
    "subprocess",
    "testing",
    "vitest"
  ],
  "homepage": "https://github.com/bhouston/vitest-command-line#readme",
  "bugs": {
    "url": "https://github.com/bhouston/vitest-command-line/issues"
  },
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/vitest-command-line.git"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./yargs": {
      "types": "./dist/yargs.d.ts",
      "import": "./dist/yargs.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc",
    "tsc": "tsc",
    "dev": "tsc -w --preserveWatchOutput --noEmitOnError",
    "test": "vitest run",
    "test:types": "pnpm build && tsc -p tsconfig.type-test.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt .",
    "lint": "oxlint --type-aware --type-check .",
    "lint:fix": "oxlint --type-aware --type-check --fix .",
    "release": "semantic-release",
    "size": "size-limit",
    "package:check": "npm pack --dry-run --ignore-scripts",
    "test:workflow": "node --test scripts/workflow.test.mjs"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.36",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^22.20.5",
    "@types/yargs": "^17.0.35",
    "@visulima/yaml": "1.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "semantic-release": "^25.0.9",
    "size-limit": "^14.3.0",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yargs": "^18.2.0"
  },
  "peerDependencies": {
    "vitest": ">=1 <6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "size-limit": [
    {
      "name": "All runtime JavaScript (gzip)",
      "path": "dist/**/*.js",
      "limit": "20 kB",
      "gzip": true
    }
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1"
}
